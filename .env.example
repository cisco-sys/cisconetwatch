# Public (browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
COLLECTOR_API_KEY=

# Optional build
# DIST_DIR=.next

# LAN collector (Windows/Linux) — set on the collector host, not required in Vercel browser
# CNW_API_URL=https://cisconetwatch-cisco-7ce5.vercel.app
# CNW_COLLECTOR_KEY=<same as COLLECTOR_API_KEY>
# CNW_ORG_ID=<uuid from public.organizations>
# CNW_DEVICE_IPS=192.168.1.1,192.168.1.2
# CNW_COLLECTOR_NAME=ICMP-LAN-01
# CNW_COLLECTOR_HOST=10.0.0.10
